{
  "name": "mttx",
  "displayName": "MTTX",
  "description": "MTTU and MTTR of each dependency in package.json",
  "version": "0.0.1",
  "publisher": "imranur-rahman",
  "license": "MIT",
  "private": true,
  "icon": "images/icon.png",
  "homepage": "https://github.com/imranur-rahman/dependency-update-metrics/tree/main/extension#readme",
  "bugs": {
    "url": "https://github.com/imranur-rahman/dependency-update-metrics/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imranur-rahman/dependency-update-metrics",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/package.json",
    "onLanguage:json"
  ],
  "contributes": {
    "configuration": {
      "title": "MTTX",
      "properties": {
        "mttx.toolPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path of an installed `dependency-metrics`. Empty: the Extension runs `dependency-metrics` from the `PATH`."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/unit/*.test.ts\"",
    "test:integration": "node esbuild.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/integration/run.ts",
    "test": "npm run check-types && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies --out mttx.vsix"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

# The configuration of the Host on the VM. Copy this file to host/.env on the VM and fill in
# the values. host/.env holds secrets: keep it only on the VM (chmod 600), never in git.
# host/README.md describes each DM_HOST_* variable of the API and the workers.

# --- Secrets (only on the VM) ----------------------------------------------------------
# The Turnstile secret key (Cloudflare dashboard > Turnstile > your widget). The API does
# not start without it. The matching site key goes in the repository variable
# DM_TURNSTILE_SITE_KEY, not here.
DM_HOST_TURNSTILE_SECRET=
# The DuckDNS token (https://www.duckdns.org, top of the page after you sign in).
DM_HOST_DUCKDNS_TOKEN=
# The key of the IP hash. Make it once with `openssl rand -hex 32` and keep it, because a new
# key resets the per-IP limits.
DM_HOST_IP_HASH_KEY=

# --- Public address ---------------------------------------------------------------------
# The DuckDNS subdomain without ".duckdns.org". The Host URL is then
# https://<subdomain>.duckdns.org (the repository variable DM_HOST_URL).
DM_HOST_DUCKDNS_SUBDOMAIN=
# The e-mail address that Let's Encrypt sends certificate notices to.
DM_HOST_ACME_EMAIL=

# --- API --------------------------------------------------------------------------------
# The Webapp origin. CORS allows only this origin.
DM_HOST_ALLOWED_ORIGINS=https://imranur-rahman.github.io
DM_HOST_MAX_ACTIVE_JOBS_PER_IP=1
DM_HOST_MAX_JOBS_PER_IP_PER_HOUR=10
DM_HOST_MAX_WAITING_JOBS=20

# --- Workers ----------------------------------------------------------------------------
DM_HOST_WORKERS=6
DM_HOST_JOB_TIMEOUT_SECONDS=900
DM_HOST_WORKER_MEMORY_MB=2048

# --- Disk alert -------------------------------------------------------------------------
# The ping URL of the Healthchecks.io check that host/disk-check.sh calls (empty: no alert).
DM_HOST_DISK_CHECK_URL=

# --- Set by host/compose.yaml (do not set them here) -------------------------------------
# DM_HOST_DB=/data/queue/jobs.db
# DM_HOST_OUTPUT_DIR=/data/tool
# DM_HOST_TRUSTED_PROXIES=172.30.0.10   (the fixed address of the Caddy container)

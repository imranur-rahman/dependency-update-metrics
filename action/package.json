{
  "name": "mttx-action",
  "description": "GitHub Action that reports the MTTU and MTTR of packages and of the dependencies that a pull request adds",
  "version": "1.0.2",
  "license": "MIT",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/*.test.ts\"",
    "test:e2e": "node esbuild.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/e2e/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
